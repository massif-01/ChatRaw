# Example for the verified, unauthenticated RM-01 LAN endpoint only.
# Install as /etc/chatraw-runner/environment, root:<service group>, mode 0640.
# Replace addresses/model names and use real credentials for authenticated services.
PATH="/opt/chatraw-agents/codex/node_modules/.bin:/opt/chatraw-agents/pi/node_modules/.bin:/opt/chatraw-agents/hermes/source/.venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
NO_PROXY="127.0.0.1,localhost,10.10.99.98,10.10.99.99"
no_proxy="127.0.0.1,localhost,10.10.99.98,10.10.99.99"
CODEX_HOME="/var/lib/chatraw-runner/codex-home"
CLAUDE_CONFIG_DIR="/var/lib/chatraw-runner/claude-home"
PI_CODING_AGENT_DIR="/var/lib/chatraw-runner/pi-home"
HERMES_HOME="/var/lib/chatraw-runner/hermes-home"
HERMES_GATEWAY_LOCK_DIR="/var/lib/chatraw-runner/hermes-locks"
ANTHROPIC_BASE_URL="http://10.10.99.98:58000"
ANTHROPIC_API_KEY="local-no-auth-placeholder"
ANTHROPIC_DEFAULT_HAIKU_MODEL="RM-01 VLM"
ANTHROPIC_DEFAULT_SONNET_MODEL="RM-01 VLM"
ANTHROPIC_DEFAULT_OPUS_MODEL="RM-01 VLM"
DEEPSEEK_BASE_URL="http://10.10.99.98:58000/v1"
DEEPSEEK_API_KEY="local-no-auth-placeholder"
OPENAI_BASE_URL="http://10.10.99.98:58000/v1"
OPENAI_API_KEY="local-no-auth-placeholder"
DISABLE_TELEMETRY="1"
DISABLE_ERROR_REPORTING="1"
DISABLE_NONESSENTIAL_MODEL_CALLS="1"
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC="1"
PYTHONUNBUFFERED="1"
NO_COLOR="1"
